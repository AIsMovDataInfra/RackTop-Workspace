# Copy to team-web/.env; never commit real credentials.
# Run: node --env-file=team-web/.env team-web/server/server.mjs
NODE_ENV=production
TEAM_AUTH_MODE=feishu
TEAM_HOST=127.0.0.1
TEAM_PORT=4318
TEAM_PUBLIC_URL=https://reservations.example.com
TEAM_DB_PATH=./team-web/data/team.sqlite

# Configure a Feishu web app and permit the intended team members.
# Redirect URL: https://reservations.example.com/api/auth/feishu/callback
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Comma-separated allowed tenant_key values; empty must deny access.
FEISHU_TENANT_KEYS=
# Comma-separated open_id values; these members can manage resources.
FEISHU_ADMIN_OPEN_IDS=

# Optional: custom group bot webhook. Leave empty until the team is ready.
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
