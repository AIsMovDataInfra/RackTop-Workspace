# Production single-team account service. Never commit a filled .env.
NODE_ENV=production
TEAM_AUTH_MODE=account
TEAM_HOST=127.0.0.1
TEAM_PORT=4318
TEAM_PUBLIC_URL=https://136.0.110.161
TEAM_DB_PATH=/var/lib/racktop-team/team.sqlite
# Optional legacy resource-administrator claim (role=admin, not super administrator).
# This claim does not assign a company; the super administrator must do that.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Open /#setup=<this code> privately to claim a resource administrator once.
# Leave both claim fields empty when using only the explicit super-admin setup below.
TEAM_BOOTSTRAP_TOKEN=
# Optional reserved resource-administrator username. Empty allows a name chosen on the setup page.
TEAM_ADMIN_USERNAME=
# Super administrator: explicitly run scripts/team-admin.mjs create before public registration.
# Default CLI username is admin; supply the password over protected stdin, never here.
# Startup does not create/reset it; existing ordinary accounts are never auto-promoted.
# Staff company is assigned in member management: A公司 / B公司 / C公司 / 西浦.
# Unassigned staff can sign in/change their own password but cannot use business APIs.
# Recovery requests need no email configuration; only the super administrator resets staff passwords.
# Only true behind a trusted loopback reverse proxy that overwrites X-Real-IP.
TEAM_TRUST_PROXY=true
# Shared SSH passwords: standard base64 of 32 random bytes, generated once.
# Keep the real value outside Git/releases in a private EnvironmentFile and
# retain an independent matching recovery copy. Never regenerate on deployment.
TEAM_SERVER_CREDENTIAL_KEY=
# Optional legacy Feishu mode / group notifications (not needed for account mode).
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_KEYS=
FEISHU_ADMIN_OPEN_IDS=
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
