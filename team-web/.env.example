# Production single-team account service. Never commit a filled .env.
NODE_ENV=production
TEAM_AUTH_MODE=account
TEAM_HOST=127.0.0.1
TEAM_PORT=4318
TEAM_PUBLIC_URL=https://136.0.110.161
TEAM_DB_PATH=/var/lib/racktop-team/team.sqlite
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Open /#setup=<this code> privately to create the first administrator.
TEAM_BOOTSTRAP_TOKEN=
# Optional reserved first administrator username. Empty allows a name chosen on the setup page.
TEAM_ADMIN_USERNAME=
# Only true behind a trusted loopback reverse proxy that overwrites X-Real-IP.
TEAM_TRUST_PROXY=true
# Optional legacy Feishu mode / group notifications (not needed for account mode).
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_KEYS=
FEISHU_ADMIN_OPEN_IDS=
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
