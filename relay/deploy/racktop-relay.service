[Unit]
Description=RackTop authenticated WebSocket relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=racktop-relay
Group=racktop-relay
WorkingDirectory=/opt/racktop-relay
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=192
Environment=RELAY_OWNER_TOKEN_FILE=/etc/racktop-relay/owner-token
ExecStart=/usr/bin/node /opt/racktop-relay/src/relay.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=64
MemoryMax=384M
LimitNOFILE=1024
StandardOutput=journal
StandardError=journal
SyslogIdentifier=racktop-relay

[Install]
WantedBy=multi-user.target
