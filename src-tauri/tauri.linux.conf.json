{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RackTop",
        "width": 1320,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "publisher": "AIsMov",
    "homepage": "https://github.com/AIsMovDataInfra/RackTop",
    "createUpdaterArtifacts": false,
    "targets": [
      "deb"
    ],
    "linux": {
      "deb": {
        "depends": [
          "openssh-client",
          "libdbus-1-3",
          "policykit-1",
          "apt"
        ],
        "recommends": [
          "gnome-keyring",
          "x-terminal-emulator"
        ],
        "files": {
          "/usr/share/doc/rack-top/LICENSE": "../LICENSE",
          "/usr/share/doc/rack-top/NOTICE.md": "../NOTICE.md"
        }
      }
    }
  }
}
