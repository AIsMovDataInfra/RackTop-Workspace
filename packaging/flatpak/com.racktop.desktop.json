{
  "app-id": "com.racktop.desktop",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "racktop",
  "default-branch": "stable",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=ssh-auth",
    "--device=dri",
    "--filesystem=host",
    "--filesystem=xdg-run/tray-icon:create",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/lib/cmake",
    "/share/aclocal",
    "/share/gtk-doc",
    "/share/man",
    "*.a",
    "*.la"
  ],
  "modules": [
    {
      "name": "intltool",
      "cleanup": [
        "*"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://launchpad.net/intltool/trunk/0.51.0/+download/intltool-0.51.0.tar.gz",
          "sha256": "67c74d94196b153b774ab9f89b2fa6c6ba79352407037c8c14d5aeb334e959cd"
        },
        {
          "type": "patch",
          "path": "intltool-perl5.26-regex-fixes.patch"
        }
      ]
    },
    {
      "name": "libdbusmenu-gtk3",
      "buildsystem": "autotools",
      "build-options": {
        "cflags": "-std=gnu17 -Wno-error",
        "env": {
          "HAVE_VALGRIND_FALSE": "#",
          "HAVE_VALGRIND_TRUE": ""
        }
      },
      "config-opts": [
        "--with-gtk=3",
        "--disable-dumper",
        "--disable-static",
        "--disable-nls",
        "--disable-tests",
        "--disable-vala",
        "--disable-introspection",
        "--disable-gtk-doc"
      ],
      "post-install": [
        "install -d /app/share/licenses/libdbusmenu && cp COPYING* /app/share/licenses/libdbusmenu/"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://launchpad.net/libdbusmenu/16.04/16.04.0/+download/libdbusmenu-16.04.0.tar.gz",
          "sha256": "b9cc4a2acd74509435892823607d966d424bd9ad5d0b00938f27240a1bfa878a"
        }
      ]
    },
    {
      "name": "ayatana-ido",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DENABLE_TESTS=OFF"
      ],
      "post-install": [
        "install -d /app/share/licenses/ayatana-ido && cp COPYING* /app/share/licenses/ayatana-ido/"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/AyatanaIndicators/ayatana-ido/archive/refs/tags/0.10.4.tar.gz",
          "sha256": "bd59abd5f1314e411d0d55ce3643e91cef633271f58126be529de5fb71c5ab38"
        }
      ]
    },
    {
      "name": "libayatana-indicator",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DENABLE_TESTS=OFF",
        "-DENABLE_LOADER=OFF"
      ],
      "post-install": [
        "install -Dm644 COPYING /app/share/licenses/libayatana-indicator/COPYING"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/AyatanaIndicators/libayatana-indicator/archive/refs/tags/0.9.4.tar.gz",
          "sha256": "a18d3c682e29afd77db24366f8475b26bda22b0e16ff569a2ec71cd6eb4eac95"
        }
      ]
    },
    {
      "name": "libayatana-appindicator",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DENABLE_TESTS=OFF",
        "-DENABLE_GTKDOC=OFF",
        "-DENABLE_BINDINGS_MONO=OFF",
        "-DENABLE_BINDINGS_VALA=OFF"
      ],
      "post-install": [
        "install -d /app/share/licenses/libayatana-appindicator && cp COPYING* /app/share/licenses/libayatana-appindicator/"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/AyatanaIndicators/libayatana-appindicator/archive/refs/tags/0.5.93.tar.gz",
          "sha256": "cbefed7a918a227bf71286246e237fcd3a9c8499b3eaac4897811a869409edf0"
        }
      ]
    },
    {
      "name": "openssh-client",
      "buildsystem": "simple",
      "build-commands": [
        "./configure --prefix=/app --sysconfdir=/etc/ssh --with-privsep-path=/app/var/empty --without-pam",
        "make -j${FLATPAK_BUILDER_N_JOBS} ssh ssh-keygen ssh-keyscan ssh-pkcs11-helper ssh-sk-helper",
        "install -Dm755 ssh /app/bin/ssh && install -Dm755 ssh-keygen /app/bin/ssh-keygen && install -Dm755 ssh-keyscan /app/bin/ssh-keyscan",
        "install -Dm755 ssh-pkcs11-helper /app/libexec/ssh-pkcs11-helper && install -Dm755 ssh-sk-helper /app/libexec/ssh-sk-helper",
        "install -Dm644 LICENCE /app/share/licenses/openssh/LICENCE"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-10.5p1.tar.gz",
          "sha256": "d44d28a839ea9daf969cc69150fde59910b2b39361dad81a3bd6cbd19218db11"
        }
      ]
    },
    {
      "name": "racktop",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 racktop /app/bin/racktop",
        "install -Dm755 x-terminal-emulator /app/bin/x-terminal-emulator",
        "install -Dm644 com.racktop.desktop.desktop /app/share/applications/com.racktop.desktop.desktop",
        "install -Dm644 com.racktop.desktop.metainfo.xml /app/share/metainfo/com.racktop.desktop.metainfo.xml",
        "install -Dm644 icon.png /app/share/icons/hicolor/128x128/apps/com.racktop.desktop.png",
        "install -Dm644 LICENSE /app/share/licenses/racktop/LICENSE",
        "install -Dm644 NOTICE.md /app/share/licenses/racktop/NOTICE.md"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "racktop-payload"
        }
      ]
    }
  ]
}
